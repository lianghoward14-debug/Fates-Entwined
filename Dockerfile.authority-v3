FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV FATE_SERVER_AUTHORITATIVE_V3_ENABLED=1
ENV FATE_AUTHORITY_V3_HOST=0.0.0.0
ENV FATE_AUTHORITY_V3_PORT=8790
ENV FATE_AUTHORITY_V3_DATA_DIR=/data/fate-authority-v3

COPY server ./server
COPY shared ./shared
COPY src/scripts/01-data-and-state.js ./src/scripts/01-data-and-state.js

EXPOSE 8790

CMD ["node", "server/authoritative-v3/server.mjs"]

