FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV FATE_SERVER_AUTHORITATIVE_V3_PHASE7_BETA_ENABLED=1

COPY server/authoritative-v3 ./server/authoritative-v3
COPY server/fate-card-catalog.js ./server/fate-card-catalog.js
COPY server/fate-deck-catalog.js ./server/fate-deck-catalog.js
COPY shared ./shared
COPY src/scripts/01-data-and-state.js ./src/scripts/01-data-and-state.js
COPY src/scripts/04-game-setup.js ./src/scripts/04-game-setup.js
COPY src/scripts/authoritative-v3-ai-policy.mjs ./src/scripts/authoritative-v3-ai-policy.mjs

COPY src/scripts/09-challenger-mode.js ./src/scripts/09-challenger-mode.js

EXPOSE 8787

CMD ["node", "server/authoritative-v3/phase7-beta-server.mjs"]

ENV FATE_WEBSITE_DIR=/app/public
COPY index.html manifest.json pwa-icon.svg sw.js voicelines.txt /app/public/
COPY *.png /app/public/
COPY src /app/public/src
COPY shared /app/public/shared
COPY optimized /app/public/optimized
COPY titlscreenbackgrounds /app/public/titlscreenbackgrounds
COPY ingamebackgrouds /app/public/ingamebackgrouds
COPY igb17 /app/public/igb17
COPY setvoicelines /app/public/setvoicelines
COPY ["new voices", "/app/public/new voices"]
COPY soundeffects /app/public/soundeffects
COPY afficon /app/public/afficon
COPY aiicons /app/public/aiicons
COPY rankicons /app/public/rankicons
COPY pfp /app/public/pfp
COPY UIpictures /app/public/UIpictures
COPY assets /app/public/assets
COPY *.mp3 /app/public/
